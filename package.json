{
  "name": "riverbed",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "jest --watchAll",
    "test:ci": "jest",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "format": "oxfmt src cypress/e2e",
    "format:check": "oxfmt --check src cypress/e2e",
    "lint": "oxlint src cypress/e2e --max-warnings=0",
    "build": "vite build",
    "deploy": "netlify deploy --prod",
    "prepare": "husky"
  },
  "dependencies": {
    "@codingitwrong/jsonapi-client": "^0.0.11",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/x-date-pickers": "^8.29.2",
    "@tanstack/react-query": "^5.101.0",
    "@vis.gl/react-google-maps": "^1.10.1",
    "dayjs": "^1.11.21",
    "lodash": "^4.18.1",
    "react": "19.3.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-beforeunload": "^2.7.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.16.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.1",
    "dotenv": "^17.4.2",
    "eslint-plugin-cypress": "^7.0.2",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.71.0",
    "vite": "8.3.2"
  },
  "private": true,
  "engines": {
    "pnpm": ">=11 <12"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "modulePathIgnorePatterns": [
      "cypress",
      "<rootDir>/.claude"
    ],
    "setupFilesAfterEnv": [
      "./setupTests.js"
    ],
    "moduleNameMapper": {
      ".css$": "identity-obj-proxy"
    }
  }
}
