{
  "name": "riverbed",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "webpack server --config webpack.dev.js",
    "test": "jest --watchAll",
    "test:ci": "jest",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "format": "oxfmt src cypress/e2e",
    "format:check": "oxfmt --check src cypress/e2e",
    "lint": "oxlint src cypress/e2e --max-warnings=0",
    "build": "webpack --config webpack.prod.js",
    "explore:app": "source-map-explorer dist/app.*.js",
    "explore:vendors": "source-map-explorer dist/vendors.*.js",
    "deploy": "netlify deploy --prod",
    "prepare": "husky"
  },
  "dependencies": {
    "@codingitwrong/jsonapi-client": "^0.0.11",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/x-date-pickers": "^7.28.3",
    "@tanstack/react-query": "^5.101.0",
    "dayjs": "^1.11.21",
    "google-maps-react": "^2.0.6",
    "lodash": "^4.18.1",
    "react": "18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-beforeunload": "^2.7.0",
    "react-dom": "18.3.1",
    "react-native": "0.71.7",
    "react-native-web": "~0.18.9",
    "react-router-dom": "^7.16.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cypress": "^15.16.0",
    "dotenv": "^17.4.2",
    "eslint-plugin-cypress": "^3.6.0",
    "html-webpack-plugin": "^5.6.7",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "oxfmt": "0.56.0",
    "oxlint": "1.71.0",
    "source-map-explorer": "^2.5.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1"
  },
  "private": true,
  "engines": {
    "pnpm": ">=11 <12"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "modulePathIgnorePatterns": [
      "cypress"
    ],
    "setupFilesAfterEnv": [
      "./setupTests.js"
    ]
  }
}
